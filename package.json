{
  "name": "moventra",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:client": "pnpm --filter @moventra/client dev",
    "dev:admin": "pnpm --filter @moventra/admin dev",
    "build": "pnpm build:client && pnpm build:admin",
    "build:client": "pnpm --filter @moventra/client build",
    "build:admin": "pnpm --filter @moventra/admin build",
    "test": "pnpm check:boundaries && node --test tests/frontend/admin-admission.test.mjs tests/frontend/session-state.test.mjs tests/frontend/personal-v1.test.mjs tests/frontend/operations-overview.test.mjs tests/frontend/transaction-date-range.test.mjs tests/frontend/card-transaction-fields.test.mjs tests/frontend/transaction-drawer.test.mjs tests/frontend/finance-money-display.test.mjs tests/frontend/finance-quote-contract.test.mjs tests/frontend/v1-fee-plan-navigation.test.mjs deploy/cloudflare/gateway.test.mjs",
    "typecheck": "pnpm --filter @moventra/client typecheck && pnpm --filter @moventra/admin typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/public-sans": "^5.1.1",
    "@hookform/resolvers": "3.9.1",
    "@iconify/react": "^5.1.0",
    "@mui/material": "^5.16.14",
    "@mui/x-data-grid": "^7.23.5",
    "apexcharts": "^3.54.1",
    "firebase": "^12.18.0",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-apexcharts": "1.4.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "^6.28.0",
    "yup": "1.4.0"
  }
}
