{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moventra-web",
  "main": "gateway.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/admin-api",
      "/admin-api/*",
      "/client-api",
      "/client-api/*",
      "/local-slash-demo",
      "/local-slash-demo/*",
      "/login",
      "/admin",
      "/admin/*",
      "/portal",
      "/portal/*",
      "/register"
    ]
  },
  "vars": {
    "API_ORIGIN": ""
  },
  "env": {
    "staging": {
      "name": "moventra-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "API_ORIGIN": ""
      }
    },
    "production": {
      "name": "moventra-web",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "API_ORIGIN": "https://moventra-api-ejeq.onrender.com",
        "SITE_KIND": "client"
      },
      "routes": [
        {
          "pattern": "www.moventra.me",
          "custom_domain": true
        },
        {
          "pattern": "moventra.me",
          "custom_domain": true
        },
        {
          "pattern": "moventra.apexisnetworking.work",
          "custom_domain": true
        }
      ],
      "send_email": [
        {
          "name": "CONTACT_EMAIL",
          "destination_address": "info@moventra.me",
          "allowed_sender_addresses": [
            "website@mail.moventra.me"
          ]
        }
      ],
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ]
    }
  },
  "account_id": "1159a5e57869211278b99f401f41321a"
}
