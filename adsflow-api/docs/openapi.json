      "post": {
        "operationId": "submitBusinessUpgrade",
        "description": "Personal owner only. An intent application, not complete KYB. Replays with the same key and normalized name return 200. First submission returns 201. Different payload or another open application returns 409. No financial or ownership mutation.",
        "parameters": [
          {
            "name": "customerID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Requested subject, verified against server-side ownership or grants."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "legalName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "legalName"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
