    "/api/v1/me": {
      "get": {
        "operationId": "getIdentity",
        "responses": {
          "200": {
            "description": "Authenticated identity and owned/member subjects",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "customers": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Customer"
                          }
                        },
                        "operator": {
                          "type": "boolean",
                          "description": "Has one or more explicit staff grants; not a global authorization."
                        },
                        "mfaVerified": {
                          "type": "boolean"
                        },
                        "requiresMfa": {
                          "type": "boolean"
                        },
                        "staffScopes": {
                          "type": "array",
                          "description": "Empty until MFA is verified. Every query rechecks authorization.",
                          "items": {
                            "type": "object",
                            "required": [
                              "customerId",
                              "name",
                              "permission"
                            ],
                            "properties": {
                              "customerId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              },
                              "permission": {
                                "type": "string",
                                "enum": [
                                  "accounts:read",
                                  "transactions:read"
                                ]
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "id",
                        "customers",
                        "operator",
                        "mfaVerified",
                        "requiresMfa",
                        "staffScopes"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, revoked or unverified-email identity",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Local user not active or staff MFA absent",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Read identity and accessible customer subjects"
      }
    },
