{
  "name": "adsflow-admin-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "demo:api": "node demo-server/server.mjs",
    "demo:web": "vite --host 0.0.0.0 --mode demo",
    "demo": "node demo-server/start.mjs",
    "demo:import": "node demo-server/import-snapshot.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "slash:demo": "node demo-server/slash/start.mjs",
    "slash:import": "node demo-server/slash/cli.mjs import",
    "slash:clean": "node demo-server/slash/cli.mjs clean",
    "slash:status": "node demo-server/slash/cli.mjs status",
    "slash:test": "node --test tests/slash-demo.test.mjs",
    "management:init": "node demo-server/slash/cli.mjs management-init",
    "management:clean": "node demo-server/slash/cli.mjs management-clean",
    "management:test": "node --test tests/management.test.mjs",
    "fx:import": "node demo-server/slash/fx/cli.mjs import",
    "fx:clean": "node demo-server/slash/fx/cli.mjs clean",
    "fx:status": "node demo-server/slash/fx/cli.mjs status",
    "fx:test": "node --test tests/fx.test.mjs",
    "cards:init": "node demo-server/slash/card-admin-cli.mjs init",
    "cards:clean": "node demo-server/slash/card-admin-cli.mjs clean",
    "cards:status": "node demo-server/slash/card-admin-cli.mjs status",
    "cards:test": "node --test tests/card-administration.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/public-sans": "^5.1.1",
    "@hookform/resolvers": "3.9.1",
    "@iconify/react": "^5.1.0",
    "@mui/material": "^5.16.14",
    "@mui/x-data-grid": "^7.23.5",
    "apexcharts": "^3.54.1",
    "firebase": "^12.18.0",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-apexcharts": "1.4.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "^6.28.0",
    "yup": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
