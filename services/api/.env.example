# Inject into the process; this executable does not auto-load dotenv files.
DATABASE_URL=postgresql://localhost/moventra_development?sslmode=disable
FIREBASE_PROJECT_ID=edi-gws-20260309-hk
# Absolute path to a secret file outside the repository (Render Secret Files supported).
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8870

# Optional isolated local shadow ledger; disabled by default.
LEDGER_MODE=disabled
BLNK_URL=http://127.0.0.1:5501
BLNK_API_KEY=
BLNK_NAMESPACE=shadow_development
BLNK_LEDGER_ID=general_ledger_id
# Shadow mode requires a local moventra_shadow_* or moventra_test_* DATABASE_URL.

# Per-process connection budget, 1..100 (default 5).
DB_MAX_CONNS=5
