FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/issuing-worker ./cmd/issuing-worker
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /issuing-worker ./cmd/issuing-worker

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
COPY --from=build /issuing-worker /usr/local/bin/issuing-worker
USER app
ENTRYPOINT ["/usr/local/bin/issuing-worker"]
