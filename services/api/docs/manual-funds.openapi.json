  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerId",
          "source",
          "currency",
          "amountMinor",
          "note",
          "evidenceRef"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "platform_advance",
              "offline_receipt",
              "advance_recovery",
              "offline_payout",
              "reversal"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,37}$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "originalId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
