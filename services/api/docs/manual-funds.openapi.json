{
  "openapi": "3.0.3",
  "info": {
    "title": "Moventra balance inquiry and manual funds",
    "version": "1.1.0",
    "description": "USD manual accounting. Production uses no-review policy when MANUAL_FUNDS_REQUIRE_REVIEW=false. Creation then requires create and execute grants. Offline payment confirmation remains separate; no bank or channel payment is sent."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin-api/v1/balances": {
      "get": {
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success. mode and enabled describe availability; approvalRequired describes the review policy. Accounting completion and actual external payment remain separate.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "approvalRequired": {
                          "type": "boolean",
                          "description": "False when submissions proceed without a separate review stage."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "MFA, role, action permission or service status rejected"
          },
          "404": {
            "description": "No resource access"
          },
          "409": {
            "description": "Stale revision, repeated evidence or conflict"
          },
          "503": {
            "description": "Ledger, audit, migration or service unavailable"
          }
        }
      }
    },
